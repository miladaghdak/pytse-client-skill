# PostgreSQL connection string used by the studio app and drizzle-kit.
# Local dev: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon free tier: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL, used for OpenGraph metadata. Set to your production URL when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
